# ===== قاعدة البيانات (Supabase) =====
# الـ pooler (منفذ 6543) لدوال الخادم — لا تضع القيمة الحقيقية هنا، بل في .env.local
DATABASE_URL=
# الاتصال المباشر (منفذ 5432) — للترحيلات والبذر فقط
DIRECT_URL=

# ===== الأسرار =====
# مِلح تلبيد رمز المتابعة ومعرّف الجهاز:  openssl rand -hex 32
REF_CODE_PEPPER=
# رمز دخول لوحة سفير التغيير (بلا حساب مستخدم)
ADMIN_PASSCODE=
# ترويسة تحمي مسار الاحتفاظ المجدول:  openssl rand -hex 32
CRON_SECRET=
