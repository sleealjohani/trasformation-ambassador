# ===== قاعدة البيانات (Supabase) =====
# انسخ السلسلتين من: Supabase → Project Settings → Database → Connection string
#
# الـ pooler (منفذ 6543) — تستخدمه دوال الخادم في التطوير والإنتاج
# الشكل:  postgresql://postgres.<project-ref>:<PASSWORD>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
#
# الاتصال المباشر (منفذ 5432) — للترحيلات والبذر فقط، لا لدوال الخادم
# الشكل:  postgresql://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
DIRECT_URL=

# ===== الأسرار =====
# مِلح تلبيد رمز المتابعة ومعرّف الجهاز:  openssl rand -hex 32
# تغييره يُبطل كل رموز المتابعة القائمة — لا يُغيَّر بعد الإطلاق.
REF_CODE_PEPPER=
# رمز دخول لوحة سفير التغيير (بلا حساب مستخدم)
ADMIN_PASSCODE=
# ترويسة تحمي مسار الاحتفاظ المجدول:  openssl rand -hex 32
CRON_SECRET=
