# ===== قاعدة البيانات =====
# سلسلة اتصال PostgreSQL. لا تضع القيمة الحقيقية هنا — ضعها في .env.local
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# ===== أسرار التطبيق =====
# مِلح تلبيد رمز المتابعة ومعرّف الجهاز (سلسلة عشوائية ٣٢ بايت بترميز base64)
HASH_SALT=""

# ===== بوابة نماذج الذكاء الاصطناعي (المرحلة ٢) =====
# لا يُنادى المزوّد من المتصفح إطلاقًا؛ النداء من الخادم فقط.
AI_GATEWAY_URL=""
AI_GATEWAY_API_KEY=""

# ===== التشغيل =====
NEXT_PUBLIC_APP_NAME="جسر التحول"
