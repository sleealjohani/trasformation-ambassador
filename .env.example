# ===== قاعدة البيانات (Supabase) =====
# المشروع: Salwa's Project (woureabyrnjlgfxcbaea)
# استبدل [DATABASE_PASSWORD] بكلمة مرور قاعدة البيانات في .env.local أو منصة النشر فقط.
#
# الـ pooler (منفذ 6543) — تستخدمه دوال الخادم في التطوير والإنتاج
DATABASE_URL=postgresql://postgres.woureabyrnjlgfxcbaea:[DATABASE_PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require
#
# الاتصال المباشر (منفذ 5432) — للترحيلات والبذر فقط، لا لدوال الخادم
DIRECT_URL=postgresql://postgres:[DATABASE_PASSWORD]@db.woureabyrnjlgfxcbaea.supabase.co:5432/postgres?sslmode=require

# ===== الأسرار =====
# مِلح تلبيد رمز المتابعة ومعرّف الجهاز:  openssl rand -hex 32
# تغييره يُبطل كل رموز المتابعة القائمة — لا يُغيَّر بعد الإطلاق.
REF_CODE_PEPPER=
# رمز دخول لوحة سفير التغيير (بلا حساب مستخدم)
ADMIN_PASSCODE=
# ترويسة تحمي مسار الاحتفاظ المجدول:  openssl rand -hex 32
CRON_SECRET=
